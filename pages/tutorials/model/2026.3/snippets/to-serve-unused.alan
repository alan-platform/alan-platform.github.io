'To serve': stategroup = switch ^ .'Order type' (
	|'Takeaway' => 'No' ( )
	|'In-house' as $'in-house' => switch .'Line status' (
		|'On hold' => 'No' ( )
		|'Placed'  => 'No' ( )
		|'Service' as $'service' => 'Yes' ( 'Table' = $^ $'in-house'>'Table' ) // <--- !! $^
		|'Served'  => 'No' ( )
	)
) (
	...
)