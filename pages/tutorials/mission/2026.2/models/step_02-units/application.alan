//@ expect error equality constraint violation
users
	anonymous

interfaces

root {
	'Vehicles': collection ['Vehicle'] {
		'Vehicle': text
		'Engines': collection ['Engine'] {
			'Engine': text
			'Thrust': number 'newton'
			'Burn time': number 'second'
			'Impulse': number 'newton second' = product ( .'Thrust' as 'newton', .'Burn time' )
		}
		//@ begin units-clash
		'Booster impulse': number 'pound-force second'
		'Engine impulse': number 'newton second' = sum .'Engines'* .'Impulse'
		'Total impulse': number 'newton second' = sum ( .'Engine impulse', .'Booster impulse' )
		//@ end units-clash
	}
}

numerical-types
	'newton'
	'second'
	'pound-force second'
	'newton second'
		= 'newton' * 'second'
