users
	dynamic: .'Crew'
		passwords: .'Passwords'
			password-value: .'Data'.'Password'
			password-status: .'Data'.'Active' (
				| active => 'Yes' ( )
				| reset => 'No' ( )
			)
			password-initializer: (
				'Data' = ( )
			)

interfaces

root {
	can-read: user

	'Crew': collection ['Call sign'] {
		'Call sign': text
		'Role': stategroup (
			'Flight director' { }
			'Loadmaster' { }
			'Observer' { }
		)
	}
	'Passwords': collection ['Member'] {
		'Member': text -> ^ .'Crew'[]
		'Data': group {
			can-update: user is ( ^ >'Member' )

			'Password': text
			'Active': stategroup (
				'No' { }
				'Yes' { }
			)
		}
	}
	'Vehicles': collection ['Vehicle'] {
		can-update: user .'Role'?'Flight director'

		'Vehicle': text
		'Landing site': text
		'Dry mass': number 'kg'
		'Propellant': number 'kg'
		'Wet mass': number 'kg' = sum ( .'Dry mass', .'Propellant' )
		'Engines': collection ['Engine'] {
			'Engine': text
			'Thrust': number 'newton'
			'Burn time': number 'second'
			'Impulse': number 'newton second' = product ( .'Thrust' as 'newton', .'Burn time' )
		}
		'Booster impulse': number 'pound-force second'
		'Engine impulse': number 'newton second' = sum .'Engines'* .'Impulse'
		'Total impulse': number 'newton second' = sum ( .'Engine impulse', from 'pound-force second' ( .'Booster impulse' ) )
		'Lift capacity': number 'kg'
		'Manifest': reference-set -> downstream ^ .'Payloads'* = inverse >'Vehicle'
		'Cargo mass': number 'kg' = sum <'Manifest'* .'Mass'
		'Margin': number 'kg' = sum ( .'Lift capacity', - .'Cargo mass' )
		'Load': stategroup = switch .'Cargo mass' compare ( .'Lift capacity' ) (
			| <= => 'Within limits' ( )
			| >  => 'Overloaded' ( )
		) (
			'Within limits' { }
			'Overloaded' { }
		)
		'Parts': collection ['Part']
			'Assembly': acyclic-graph
		{
			'Part': text
			'Part type': stategroup (
				'Component' {
					'Component mass': number 'kg'
				}
				'Built from' {
					'Subparts': collection ['Subpart'] {
						'Subpart': text -> ^ ^ sibling in ( 'Assembly' )
						'Subpart mass': number 'kg' = ( recurse ^ ^ 'Assembly' ) >'Subpart'.'Mass'
					}
				}
			)
			'Mass': number 'kg' = ( recurse 'Assembly' ) switch .'Part type' (
				|'Component' as $'component' => $'component'.'Component mass'
				|'Built from' as $'assembly' => sum $'assembly'.'Subparts'* .'Subpart mass'
			)
		}
		'Status': stategroup (
			'In assembly' {
				'Roll out to the pad': command { } => update ^ .'Status' = create 'On the pad' ( )
			}
			'On the pad' {
				'Readiness': stategroup = switch ^ .'Load' (
					|'Overloaded' => 'Hold' ( )
					|'Within limits' => switch ^ .'Propellant' compare ( 0 ) (
						| <= => 'Hold' ( )
						| >  => 'Go' ( )
					)
				) (
					'Go' {
						'Launch': command { } => update ^ ^ .'Status' = create 'In flight' ( )
					}
					'Hold' { }
				)
			}
			'In flight' {
				'Touchdown': command { } => update ^ .'Status' = create 'Landed' ( )
			}
			'Landed' { }
		)
	}
	'Payloads': collection ['Payload'] {
		can-update: user .'Role'?'Loadmaster'

		'Payload': text
		'Mass': number 'kg'
		'Vehicle': text -> ^ .'Vehicles'[]
		'Priority': stategroup (
			'Critical' { }
			'Standard' { }
		)
	}
}

numerical-types
	'kg'
	'newton'
	'second'
	'pound-force second'
	'newton second'
		= 'newton' * 'second'
		= 'pound-force second' * 4448222 * 10 ^ -6