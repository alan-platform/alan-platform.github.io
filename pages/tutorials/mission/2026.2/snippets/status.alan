'Status': stategroup (
	'In assembly' {
		'Roll out to the pad': command { } => update ^ .'Status' = create 'On the pad' ( )
	}
	'On the pad' {
		'Readiness': stategroup = switch ^ .'Load' (
			|'Overloaded' => 'Hold' ( )
			|'Within limits' => switch ^ .'Propellant' compare ( 0 ) (
				| <= => 'Hold' ( )
				| >  => 'Go' ( )
			)
		) (
			'Go' {
				'Launch': command { } => update ^ ^ .'Status' = create 'In flight' ( )
			}
			'Hold' { }
		)
	}
	'In flight' {
		'Touchdown': command { } => update ^ .'Status' = create 'Landed' ( )
	}
	'Landed' { }
)